    # ---- small helpers
    def _toggles(self, label, names, slot):
        h = W.QHBoxLayout()
        h.addWidget(W.QLabel(label))
        g = W.QButtonGroup(self)
        g.setExclusive(True)
        if not hasattr(self, '_tb'):
            self._tb = {}
        self._tb[label] = []
        for i, nm in enumerate(names):
            b = W.QPushButton(nm)
            self._tb[label].append(b)
            b.setCheckable(True)
            g.addButton(b, i)
            b.clicked.connect(lambda _=False, i=i: self._run(lambda: slot(i)))
            h.addWidget(b)
            if i == 0:
                b.setChecked(True)
        h.addStretch()
        return h

    def _run(self, fn):
        try:
            fn()
        except Exception:
            tb = traceback.format_exc()
            nuke.tprint(tb)
            self.result.setText(tb)

    def _safe(self, fn):
        return lambda *a: self._run(fn)

    def put(self, r, col, text, ok=None):
        it = W.QTableWidgetItem(str(text))
        it.setFlags(C.Qt.ItemFlag.ItemIsSelectable | C.Qt.ItemFlag.ItemIsEnabled)
        if ok is True:
            it.setBackground(GOOD)
        elif ok is False:
            it.setBackground(BAD)
        elif ok == 'warn':
            it.setBackground(WARN)
        self.t.setItem(r, COL[col], it)

    def sel_rows(self):
        return sorted(set(i.row() for i in self.t.selectedIndexes()))

    def pair_nodes(self, r):
        i, o = (self.t.item(r, 0).data(ROLE) or '|').split('|')
        return (nuke.toNode(i) if i else None), (nuke.toNode(o) if o else None)

    def _frame_for(self, n):
        d = info(n)
        return self.frame.value() or (d['first'] + d['last']) // 2

    # ---- scan: build one row per Input/Output pair
    def scan(self, only=None):
        try:
            reads = nuke.allNodes('Read', recurseGroups=True)
        except Exception:
            reads = nuke.allNodes('Read')
        if not reads:
            self.result.setText('No Read nodes found.')
            return
        pairs = find_pairs(reads)
        rows, used = [], set()
        for o in reads:
            if o.fullName() in pairs:
                inp = pairs[o.fullName()]
                rows.append((inp, o))
                if inp:
                    used.add(inp.fullName())
        for n in reads:
            if n.fullName() not in pairs and n.fullName() not in used:
                rows.append((n, None))                    # input with no output
        if only:
            rows = [(i, o) for i, o in rows
                    if (i and i.fullName() in only) or (o and o.fullName() in only)]
        rows.sort(key=lambda p: base_of(p[0] or p[1]))
        self.t.setRowCount(0)
        for inp, out in rows:
            r = self.t.rowCount()
            self.t.insertRow(r)
            self.fill_row(r, inp, out)
        self.t.resizeColumnsToContents()
        self.result.setText('%d row(s).  Green = pass, red = fail.' % len(rows))

    def scan_selected(self):
        sel = set(n.fullName() for n in nuke.selectedNodes())
        if not sel:
            self.result.setText('Select Read nodes in the node graph first.')
            return
        self.scan(only=sel)

    def fill_row(self, r, inp, out):
        shot_src = inp or out
        base = base_of(shot_src)
        if not inp:
            m = VER_RE.match(base)
            base = m.group(1) if m else base
        it = W.QTableWidgetItem(base)
        it.setData(ROLE, '%s|%s' % (inp.fullName() if inp else '', out.fullName() if out else ''))
        it.setFlags(C.Qt.ItemFlag.ItemIsSelectable | C.Qt.ItemFlag.ItemIsEnabled)
        self.t.setItem(r, 0, it)
        self.put(r, 'Input', inp.name() if inp else 'NOT FOUND', True if inp else False)
        self.put(r, 'Output', out.name() if out else 'MISSING', True if out else False)
        if not out:
            return
        try:
            d = info(out)
        except Exception:
            tb = traceback.format_exc()
            nuke.tprint(tb)
            self.result.setText(tb)
            self.put(r, 'Ver', 'ERROR', False)
            return
        isexr = d['ext'] == 'exr'
        self.put(r, 'Ver', d['ver'], d['ver'] != '-')
        self.put(r, 'Name', 'OK' if d['name_ok'] else 'BAD', d['name_ok'])
        self.put(r, 'Ext', d['ext'], d['ext'] in ('exr', 'dpx'))
        self.put(r, 'Compression', d['comp'] or '-',
                 any(c in d['comp'].lower() for c in ALLOWED_COMP) if isexr else None)
        self.put(r, 'Bits', d['bits'] or '-',
                 any(b in d['bits'] for b in ALLOWED_BITS) if isexr else None)
        self.put(r, 'Colorspace', d['cs'])
        li = info(inp)['length'] if inp else None
        self.put(r, 'Length', '%d (%d-%d)' % (d['length'], d['first'], d['last']) +
                 ('' if li is None or li == d['length'] else '  (in %d)' % li),
                 None if li is None else li == d['length'])      # only LENGTH is compared, not frame range
        self.put(r, 'Start', d['first'], (d['first'] == START_FRAME) if CHECK_START else None)
        self.put(r, 'Res', '%dx%d' % (d['w'], d['h']))
        ob = d['bbox']
        if inp:
            ib = info(inp)['bbox']
            exceed = ob[0] < ib[0] or ob[1] < ib[1] or ob[2] > ib[2] or ob[3] > ib[3]
            self.put(r, 'BBox', '%d,%d,%d,%d' % ob, False if exceed else True)
        else:
            self.put(r, 'BBox', '%d,%d,%d,%d' % ob, True if ob == (0, 0, d['w'], d['h']) else 'warn')
        self.put(r, 'DI Matte', ('%d: %s' % (len(d['mattes']), ', '.join(d['mattes']))) if d['mattes'] else '-')

    def remove_missing(self):
        n = 0
        for r in reversed(range(self.t.rowCount())):
            if not self.pair_nodes(r)[1]:
                self.t.removeRow(r)
                n += 1
        self.result.setText('Removed %d row(s) with no output.' % n)

    def remove_rows(self):
        for r in reversed(self.sel_rows()):
            self.t.removeRow(r)

    # ---- numeric checks
    def check_inout(self):
        rows = self.sel_rows() or range(self.t.rowCount())
        for r in rows:
            inp, out = self.pair_nodes(r)
            if not (inp and out):
                continue
            lines, short = compare(inp, out, self._frame_for(out))
            bad = [l.split(' ')[0] for l in lines if 'MISMATCH' in l]
            self.put(r, 'In/Out', 'OK' if not bad else 'MISMATCH: ' + ','.join(bad), not bad)
            self.put(r, 'Length', '%d (%d-%d)' % (info(out)['length'], info(out)['first'], info(out)['last']),
                     'Length' not in bad)
            self.put(r, 'Diff', short or 'res mismatch', bool(short))
            QtApp = W.QApplication.instance()
            if QtApp:
                QtApp.processEvents()
        self.t.resizeColumnsToContents()

    def run_analysis(self):
        rows = self.sel_rows() or range(self.t.rowCount())
        cmp_cols = (('black', 'Black', '%.4f'), ('white', 'White', '%.4f'),
                    ('dark', 'Dark %', '%.2f'), ('bright', 'Bright %', '%.2f'), ('sat', 'Sat', '%.3f'),
                    ('clip', 'Clip %', '%.3f'), ('grain', 'Grain', '%.3f'))
        present_cols = (('neg', 'Neg %', '%.4f'), ('dead', 'Dead px', '%d'), ('super', 'Superbright %', '%.4f'))
        for r in rows:
            inp, out = self.pair_nodes(r)
            if not out:
                continue
            f = self._frame_for(out)
            so = analyse(out, f)
            si = analyse(inp, f) if inp else None
            for key, col, fmt in cmp_cols:          # must match input, else red
                txt = fmt % so[key]
                ok = None
                if si:
                    txt += '  (in ' + fmt % si[key] + ')'
                    ok = same(key, so[key], si[key])
                self.put(r, col, txt, ok)
            for key, col, fmt in present_cols:      # present in output = red
                txt = fmt % so[key]
                if si:
                    txt += '  (in ' + fmt % si[key] + ')'
                self.put(r, col, txt, so[key] <= 0)
            QtApp = W.QApplication.instance()
            if QtApp:
                QtApp.processEvents()
        self.t.resizeColumnsToContents()
        self.result.setText('Black = lowest pixel value, White = highest pixel value (RGB, file colorspace, '
                            'float values not %). Red = output differs from input, or negative / dead / '
                            'superbright pixels present.')

    # ---- QC Tool: everything lives inside ONE group node
    def tools(self):
        return [t for t in (nuke.toNode(self.GRP + '.QC_In'), nuke.toNode(self.GRP + '.QC_Out')) if t]

    def set_knob(self, path, knob, val):
        for t in self.tools():
            n = nuke.toNode(t.fullName() + '.' + path)
            if n and knob in n.knobs():
                n[knob].setValue(val)

    def _show_controls(self):
        for row in self.rows:
            row.setVisible(row.method == self.method)
        self.wipe.setVisible(self.view == 3)
        self.dgain.setVisible(self.view == 2)

    def set_method(self, i):
        self.method = i
        self._show_controls()
        for t in self.tools():
            t['QCMethod'].setValue(i)

    def set_view(self, i):
        self.view = i
        self._show_controls()
        sw = nuke.toNode(self.GRP + '.View_Switch')
        if sw:
            sw['which'].setValue(i)

    def set_wipe(self, pct):
        m, t = nuke.toNode(self.GRP + '.QC_WipeMask'), nuke.toNode(self.GRP + '.Plate')
        if m and t:
            m['expr0'].setValue('x>%d?1:0' % int(t.format().width() * pct / 100.0))

    def set_dgain(self, v):
        d = nuke.toNode(self.GRP + '.QC_DiffGain')
        if d:
            d['value'].setValue(v)

    def _set_matte_ui(self, has):
        """DI matte controls + Matte views only exist when the output has a DI matte"""
        self.matte_box.setVisible(has)
        for i in (4, 5):
            self._tb['View:'][i].setVisible(has)
        if not has and self.view >= 4:
            self._tb['View:'][0].setChecked(True)
            self.set_view(0)

    def set_overlay(self):
        m = nuke.toNode(self.GRP + '.Matte_Color')
        if not m:
            return
        c = MATTE_COLORS.get(self.mcolor.currentText(), (1, 0, 0))
        op = self.mop.value()
        for i, v in enumerate((c[0] * op, c[1] * op, c[2] * op, 1.0)):
            m['value'].setValue(v, i)

    def refresh_mattes(self, rows):
        self.matte.blockSignals(True)
        self.matte.clear()
        if rows:
            _, out = self.pair_nodes(rows[0])
            if out:
                self.matte.addItems(find_mattes(out))
        self.matte.blockSignals(False)
        self._set_matte_ui(self.matte.count() > 0)
        self.set_matte()

    def set_matte(self):
        """point the Matte view (inside QC_Compare) at the chosen matte layer"""
        sh = nuke.toNode(self.GRP + '.Matte_View')
        out = nuke.toNode(getattr(self, 'qc_out', '') or '')
        layer = self.matte.currentText()
        if not (sh and out and layer):
            return
        matte_copy(sh, layer)

    def check_matte(self, all_mattes):
        rows = self.sel_rows() or ([0] if self.t.rowCount() else [])
        if not rows:
            self.result.setText('Select a row first.')
            return
        _, out = self.pair_nodes(rows[0])
        if not out:
            self.result.setText('Row has no output.')
            return
        mattes = find_mattes(out) if all_mattes else [self.matte.currentText()]
        mattes = [m for m in mattes if m]
        if not mattes:
            self.result.setText('No DI matte found in %s.' % out.name())
            return
        f = self._frame_for(out)
        lines, any_bad = [], False
        for m in mattes:
            st = matte_stats(out, m, f)
            problems = []
            if st['cover'] <= 0:
                problems.append('EMPTY')
            if st['neg'] > 0:
                problems.append('negative %.3f%%' % st['neg'])
            if st['over'] > 0:
                problems.append('>1 %.3f%%' % st['over'])
            any_bad = any_bad or bool(problems)
            lines.append('%s: coverage %.2f%%  mean %.4f  %s' % (
                m, st['cover'], st['mean'],
                'RED - ' + ', '.join(problems) if problems else 'OK'))
        self.result.setText('\n'.join(lines))
        if all_mattes:
            self.put(rows[0], 'DI Matte', '%d: %s' % (len(mattes), ', '.join(mattes)), not any_bad)
        self.t.resizeColumnsToContents()

    def reset_sliders(self):
        for row in self.rows:
            row.set(row.default)
        self.wipe.set(50)
        self.dgain.set(10)

    def remove_qc(self):
        for g in nuke.allNodes('Group'):               # every QC_Compare* (also auto-renamed leftovers)
            if g.name().startswith(self.GRP):
                nuke.delete(g)                         # its input links go with it
        self.qc_out = ''

    def _paste_tool(self, src, name):
        """paste QC_Tool group connected to src (call inside `with group:`)"""
        for n in nuke.allNodes():
            n.setSelected(False)
        src.setSelected(True)
        fd, tmp = tempfile.mkstemp(suffix='.nk')
        with os.fdopen(fd, 'w') as f:
            f.write(TOOL_NK)
        try:
            nuke.nodePaste(tmp)
        finally:
            os.remove(tmp)
        grp = nuke.selectedNode()
        grp['name'].setValue(name)
        with grp:                                    # Dark gain target (slider)
            cs, d3 = nuke.toNode('Colorspace1'), nuke.toNode('Dot3')
            if cs and d3:
                g = nuke.nodes.Grade(name='Dark_gain')
                g.setInput(0, cs)
                d3.setInput(0, g)
        return grp

    def build_qc(self, a, b):
        self.remove_qc()
        for n in nuke.allNodes():
            n.setSelected(False)
        grp = nuke.nodes.Group(name=self.GRP)
        grp['tile_color'].setValue(0xff9900ff)
        grp['hide_input'].setValue(True)               # no link arrows to the Reads
        grp.setInput(0, a)
        grp.setInput(1, b)
        grp.setXYpos(b.xpos() + 120, b.ypos() + 60)
        with grp:
            ia = nuke.nodes.Input(name='Plate')
            ia['number'].setValue(0)
            ib = nuke.nodes.Input(name='Render')
            ib['number'].setValue(1)
            tin = self._paste_tool(ia, 'QC_In')
            tout = self._paste_tool(ib, 'QC_Out')
            diff = nuke.nodes.Merge2(inputs=[ia, ib], operation='difference', name='QC_Diff')
            dg = nuke.nodes.Multiply(inputs=[diff], value=10, channels='rgb', name='QC_DiffGain')
            mask = nuke.nodes.Expression(inputs=[tin], channel0='rgba', expr0='x>0?1:0', name='QC_WipeMask')
            wipe = nuke.nodes.Keymix(inputs=[tin, tout, mask], name='QC_Wipe')
            mv = nuke.nodes.Copy(inputs=[ib, ib], name='Matte_View')
            col = nuke.nodes.Multiply(inputs=[mv], channels='rgb', name='Matte_Color')
            ov = nuke.nodes.Merge2(inputs=[ia, col], operation='plus', name='Matte_On_Input')
            sw = nuke.nodes.Switch(inputs=[tin, tout, dg, wipe, mv, ov], which=self.view,
                                   name='View_Switch')
            nuke.nodes.Output(inputs=[sw])
        self.qc_out = b.fullName()
        self.set_matte()
        self.set_overlay()
        for row, sp in zip(self.rows, SLIDERS):
            self.set_knob(sp[1], sp[2], row.value())
        for t in self.tools():
            t['QCMethod'].setValue(self.method)
        self.set_wipe(self.wipe.value())
        self.set_dgain(self.dgain.value())
        try:
            nuke.connectViewer(0, grp)
        except Exception:
            nuke.tprint(traceback.format_exc())
        self.result.setText('QC: %s (plate) vs %s (render). Use Check / View buttons + sliders.'
                            % (a.name(), b.name()))

    def qc_selected(self):
        rows = self.sel_rows() or ([0] if self.t.rowCount() else [])
        if not rows:
            self.result.setText('Scan first and select a row.')
            return
        inp, out = self.pair_nodes(rows[0])
        if not (inp and out):
            self.result.setText('This row has no Input/Output pair.')
            return
        self.build_qc(inp, out)

    # ---- graph <-> table selection sync
    def _table_sel(self):
        if self._busy:
            return
        self._busy = True
        try:
            rows = self.sel_rows()
            self.refresh_mattes(rows)
            if self.sync.isChecked():
                for n in nuke.allNodes(recurseGroups=True):
                    n.setSelected(False)
                for r in rows:
                    for n in self.pair_nodes(r):
                        if n:
                            n.setSelected(True)
                self._last_sel = frozenset(n.fullName() for n in nuke.selectedNodes())
            if self.auto.isChecked() and rows:
                inp, out = self.pair_nodes(rows[0])
                if inp and out:
                    self.build_qc(inp, out)
        except Exception:
            nuke.tprint(traceback.format_exc())
        finally:
            self._busy = False

    def _graph_sel(self):
        if self._busy or not self.sync.isChecked() or not self.t.rowCount():
            return
        cur = frozenset(n.fullName() for n in nuke.selectedNodes())
        if cur == self._last_sel:
            return
        self._last_sel = cur
        self._busy = True
        try:
            self.t.blockSignals(True)
            self.t.clearSelection()
            for r in range(self.t.rowCount()):
                if any(n and n.fullName() in cur for n in self.pair_nodes(r)):
                    self.t.selectRow(r)
        except Exception:
            nuke.tprint(traceback.format_exc())
        finally:
            self.t.blockSignals(False)
            self._busy = False

    def showEvent(self, e):
        nuke.addUpdateUI(self._graph_sel)
        super(QCPanel, self).showEvent(e)

    def hideEvent(self, e):
        try:
            nuke.removeUpdateUI(self._graph_sel)
        except Exception:
            pass
        super(QCPanel, self).hideEvent(e)


def register():
    nukescripts.panels.registerWidgetAsPanel('qc_panel.QCPanel', 'QC Panel', 'studio.qc.panel')