class ParamRow(W.QWidget):
    """label + slider + spinbox"""
    def __init__(self, label, lo, hi, default, cb):
        super(ParamRow, self).__init__()
        self.lo, self.hi, self.cb, self.default = lo, hi, cb, default
        lay = W.QHBoxLayout(self)
        lay.setContentsMargins(0, 0, 0, 0)
        l = W.QLabel(label)
        l.setMinimumWidth(110)
        lay.addWidget(l)
        self.sl = W.QSlider(C.Qt.Orientation.Horizontal)
        self.sl.setRange(0, 1000)
        lay.addWidget(self.sl, 1)
        self.sp = W.QDoubleSpinBox()
        self.sp.setDecimals(3)
        self.sp.setRange(lo, hi)
        self.sp.setSingleStep((hi - lo) / 100.0)
        self.sp.setMinimumWidth(80)
        lay.addWidget(self.sp)
        self.set(default, emit=False)
        self.sl.valueChanged.connect(self._from_slider)
        self.sp.valueChanged.connect(self._from_spin)

    def value(self):
        return self.sp.value()

    def set(self, v, emit=True):
        self.sp.blockSignals(True)
        self.sl.blockSignals(True)
        self.sp.setValue(v)
        self.sl.setValue(int(round(1000.0 * (v - self.lo) / (self.hi - self.lo))))
        self.sp.blockSignals(False)
        self.sl.blockSignals(False)
        if emit:
            self.cb(v)

    def _from_slider(self, i):
        self.set(self.lo + (self.hi - self.lo) * i / 1000.0)

    def _from_spin(self, v):
        self.set(v)


# ----------------------------------------------------------------- helpers
def meta(n, key):
    try:
        md = n.metadata()
    except Exception:
        return ''
    for k in sorted(md, key=len):
        if key in k.lower():
            return str(md[k])
    return ''


def fname(n):
    return os.path.basename(n['file'].value()) if 'file' in n.knobs() else ''


def base_of(n):
    """file name without extension and frame number: A_v001_V01.0001.exr -> A_v001_V01"""
    f = os.path.splitext(fname(n))[0]
    return re.sub(r'[._](\d+|%\d*d|#+)$', '', f)


def find_pairs(nodes):
    """{output fullName: input node or None}. Output = its base is an input's base + trailing version
    token (A_v001 -> A_v001_V01). Fallback: name matches shot_Name_V##_####.ext but no input found."""
    bases = {}
    for n in nodes:
        bases.setdefault(base_of(n), []).append(n)
    pairs = {}
    for n in nodes:
        m = VER_RE.match(base_of(n))
        cand = [x for x in bases.get(m.group(1), []) if x is not n] if m else []
        if cand:
            pairs[n.fullName()] = cand[0]
        elif NAME_RE.match(fname(n)):
            pairs[n.fullName()] = None
    return pairs


def find_mattes(n):
    """full channel names of every matte in node n.
    Any extra layer next to rgba counts (rain.matte, bg_rain.matte, other.bg_rain, DI_sky.alpha ...);
    colour layers (red+green+blue, e.g. AOVs) are skipped unless their layer name looks like a matte."""
    try:
        chans = list(n.channels())
    except Exception:
        return []
    layers = {}
    for c in chans:
        l, _, suf = c.partition('.')
        layers.setdefault(l, []).append(c)
    out = []
    for l in sorted(layers):
        if l.lower() in SKIP_LAYERS:
            continue
        sufs = set(c.partition('.')[2].lower() for c in layers[l])
        out.extend(sorted(layers[l]))                  # every channel of the layer can be a matte
    return out                                         # (rain.matte, rain.red, rain.alpha ...)


def matte_pick(chans):
    """preferred channel of a layer: matte > alpha > red > first"""
    for pref in ('matte', 'alpha', 'red'):
        for c in chans:
            if c.partition('.')[2].lower() == pref:
                return c
    return chans[0]


def matte_copy(node, chan):
    """point a Copy node (inputs: B=A=render) so the matte channel lands in rgba.r/g/b/a"""
    for i, to in enumerate(('rgba.red', 'rgba.green', 'rgba.blue', 'rgba.alpha')):
        node['from%d' % i].setValue(chan)
        node['to%d' % i].setValue(to)


def info(n):
    k = n.knobs()
    is_write = n.Class() == 'Write'
    base = fname(n)
    ext = os.path.splitext(base)[1].lstrip('.').lower()
    m = NAME_RE.match(base)
    v = re.search(r'_V(\d+)', base)
    fmt = n.format()
    bb = n.bbox()
    first = int(n['first'].value()) if 'first' in k else int(nuke.root().firstFrame())
    last = int(n['last'].value()) if 'last' in k else int(nuke.root().lastFrame())
    comp = bits = ''
    if ext == 'exr':
        comp = n['compression'].value() if is_write and 'compression' in k else \
            (meta(n, 'compressionname') or meta(n, 'compression'))
        comp = EXR_COMP.get(comp.strip(), comp)
        bits = n['datatype'].value() if is_write and 'datatype' in k else \
            (meta(n, 'bitsperchannel') or meta(n, 'bitdepth'))
    return dict(
        file=base, ver='V' + v.group(1) if v else '-', name_ok=bool(m), ext=ext,
        comp=comp, bits=bits,
        cs=n['colorspace'].value() if 'colorspace' in k else '',
        first=first, last=last, length=last - first + 1,
        w=fmt.width(), h=fmt.height(),
        bbox=(int(bb.x()), int(bb.y()), int(bb.x() + bb.w()), int(bb.y() + bb.h())),
        mattes=find_mattes(n),
    )


def _undo(off):
    try:
        nuke.Undo.disable() if off else nuke.Undo.enable()
    except Exception:
        pass


def analyse(n, frame):
    fmt = n.format()
    w, h = fmt.width(), fmt.height()
    cx, cy = w / 2.0, h / 2.0
    made = []

    def mk(cls, *inputs, **kn):
        x = getattr(nuke.nodes, cls)(inputs=list(inputs), **kn)
        made.append(x)
        return x

    def avg(x, chans='rgb'):
        return sum(x.sample(c, cx, cy, w, h) for c in chans) / float(len(chans))

    def mask(src, expr):
        e = mk('Expression', src, channel0='rgb', channel1='none', channel2='none',
               channel3='none', expr0='(%s)?1:0' % expr)
        return avg(e, 'r')

    L = '(0.2126*r+0.7152*g+0.0722*b)'
    mx, mn = 'max(r,max(g,b))', 'min(r,min(g,b))'
    old = nuke.frame()
    _undo(True)
    try:
        nuke.frame(frame)
        out = {}
        out['dark'] = 100 * mask(n, '%s<%f' % (L, DARK_LEVEL))
        out['bright'] = 100 * mask(n, '%s>%f' % (L, BRIGHT_LEVEL))
        e = mk('Expression', n, channel0='rgb', channel1='none', channel2='none',
               channel3='none', expr0='(%s-%s)/max(%s,0.0001)' % (mx, mn, mx))
        out['sat'] = avg(e, 'r')
        out['clip'] = 100 * mask(n, ' || '.join('abs(%s-1)<%f' % (c, CLIP_TOL) for c in 'rgb'))
        out['neg'] = 100 * mask(n, ' || '.join('%s<-0.0001' % c for c in 'rgb'))
        out['super'] = 100 * mask(n, ' || '.join('%s>%f' % (c, SUPERBRIGHT) for c in 'rgb'))
        def extreme(op):
            """real min/max over R,G,B and the whole frame: log2 reduction with Transform + Merge(min/max)"""
            cur = mk('Expression', n, channel0='rgb', channel1='none', channel2='none',
                     channel3='none', expr0='%s(r,%s(g,b))' % (op, op))
            for axis, size in ((0, w), (1, h)):
                for k in range(int(math.ceil(math.log(max(size, 2), 2)))):
                    t = mk('Transform', cur, filter='impulse')
                    t['translate'].setValue(-(2 ** k) if axis == 0 else 0, 0)
                    t['translate'].setValue(-(2 ** k) if axis == 1 else 0, 1)
                    try:
                        t['black_outside'].setValue(False)      # extend edge pixels, never add black
                    except Exception:
                        pass
                    cur = mk('Merge2', cur, t, operation=op)
            return cur.sample('r', 0, 0)

        out['black'] = extreme('min')
        out['white'] = extreme('max')
        bl = mk('Blur', n, size=2)
        out['grain'] = avg(mk('Merge2', n, bl, operation='difference')) * 100
        md = mk('Median', n, size=3)
        df = mk('Merge2', n, md, operation='difference')
        out['dead'] = int(round(mask(df, ' || '.join('%s>%f' % (c, DEAD_THRESH) for c in 'rgb')) * w * h))
        return out
    finally:
        for x in made:
            try:
                nuke.delete(x)
            except Exception:
                pass
        nuke.frame(old)
        _undo(False)


def matte_stats(n, layer, frame):
    """coverage / mean / negative / over-1 for one matte layer of node n"""
    fmt = n.format()
    w, h = fmt.width(), fmt.height()
    cx, cy = w / 2.0, h / 2.0
    made = []
    old = nuke.frame()
    _undo(True)
    try:
        nuke.frame(frame)
        sh = nuke.nodes.Copy(inputs=[n, n])
        made.append(sh)
        matte_copy(sh, layer)

        def avg(x):
            return x.sample('r', cx, cy, w, h)

        def mask(expr):
            e = nuke.nodes.Expression(inputs=[sh], channel0='rgb', channel1='none', channel2='none',
                                      channel3='none', expr0='(%s)?1:0' % expr)
            made.append(e)
            return avg(e)

        return dict(mean=avg(sh), cover=100 * mask('r>0.001'), neg=100 * mask('r<-0.0001'),
                    over=100 * mask('r>1.001'))
    finally:
        for x in made:
            try:
                nuke.delete(x)
            except Exception:
                pass
        nuke.frame(old)
        _undo(False)


def compare(a, b, frame):
    """a = input, b = output. Returns (lines, short diff text)."""
    ia, ib = info(a), info(b)
    lines = []
    same_res = (ia['w'], ia['h']) == (ib['w'], ib['h'])
    lines.append('Res %s: %dx%d vs %dx%d' % ('OK' if same_res else 'MISMATCH', ia['w'], ia['h'], ib['w'], ib['h']))
    lines.append('BBox %s: %s vs %s' % ('OK' if ia['bbox'] == ib['bbox'] else 'MISMATCH', ia['bbox'], ib['bbox']))
    lines.append('Length %s: %d vs %d' % ('OK' if ia['length'] == ib['length'] else 'MISMATCH', ia['length'], ib['length']))
    short = ''
    if same_res:
        made = []
        old = nuke.frame()
        _undo(True)
        try:
            nuke.frame(frame)
            d = nuke.nodes.Merge2(inputs=[a, b], operation='difference')
            made.append(d)
            cx, cy, w, h = ia['w'] / 2.0, ia['h'] / 2.0, ia['w'], ia['h']
            mean = sum(d.sample(c, cx, cy, w, h) for c in 'rgb') / 3.0
            e = nuke.nodes.Expression(inputs=[d], channel0='rgb', channel1='none', channel2='none',
                                      channel3='none', expr0='(r>0.001||g>0.001||b>0.001)?1:0')
            made.append(e)
            pct = 100 * e.sample('r', cx, cy, w, h)
            lines.append('Diff mean %.6f | %.3f%% px differ (f%d)' % (mean, pct, frame))
            short = '%.5f / %.2f%%' % (mean, pct)
        finally:
            for x in made:
                nuke.delete(x)
            nuke.frame(old)
            _undo(False)
    return lines, short


# ----------------------------------------------------------------- panel
class QCPanel(W.QWidget):
